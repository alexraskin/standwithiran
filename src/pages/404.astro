---
// A real 404 rather than a redirect to `/`, so search engines drop bogus URLs
// instead of indexing them as duplicates of the homepage. CloudFront serves
// this file with a 404 status for any missing key.
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';
---

<BaseLayout
  lang="en"
  title="Page not found — Stand With Iran"
  description="This page does not exist. Return to Stand With Iran for resources, organizations, and ways to help."
>
  <header class="page-head wrap">
    <p class="eyebrow">404</p>
    <h1>{t('en', 'notFoundTitle')}</h1>
    <p class="lede">{t('en', 'notFoundText')}</p>
    <p class="lede" lang="fa" dir="rtl">{t('fa', 'notFoundText')}</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">{t('en', 'backHome')}</a>
      <a class="btn btn-outline" href="/fa/" hreflang="fa" lang="fa">{t('fa', 'backHome')}</a>
    </div>
  </header>
</BaseLayout>
