---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { VICTIM_GROUPS } from '../../lib/content-schema';
import { formatDate, localeStaticPaths, localizeDigits, t, type Lang, type TranslationKey } from '../../lib/i18n';
import { getSiteData, getVictimStats, getVictims } from '../../lib/site-data';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const site = await getSiteData();
const victims = await getVictims();
const stats = await getVictimStats();
const orgs = site.links.filter((l) => l.documentation);

const groups = VICTIM_GROUPS.map((group) => ({
  group,
  victims: victims
    .filter((v) => v.group === group)
    .sort((a, b) => a.date.localeCompare(b.date)),
})).filter((g) => g.victims.length > 0);
---

<BaseLayout lang={lang} page="victims">
  <PageHead lang={lang} page="victims" intro={t(lang, 'victimsIntro')} />
  <div class="wrap page-body">
    <section aria-labelledby="stats-heading">
      <h2 id="stats-heading" class="list-heading">{t(lang, 'victimsStatsHeading')}</h2>
      <ul class="victim-stats">
        {stats.map((s) => (
          <li class="victim-stat">
            <p class="victim-stat-figure">{localizeDigits(s.figure, lang)}</p>
            <p>{lang === 'fa' && s.label_fa ? s.label_fa : s.label}</p>
            <a class="text-link" href={s.url} target="_blank" rel="noopener noreferrer">
              {s.source} <span class="arrow" aria-hidden="true">→</span>
              <span class="sr-only">{t(lang, 'opensNewTab')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {groups.map((g) => (
      <section aria-labelledby={`vic-${g.group}`}>
        <h2 id={`vic-${g.group}`} class="list-heading">
          {t(lang, `vic_${g.group}` as TranslationKey)}
        </h2>
        <ul class="victims">
          {g.victims.map((v) => (
            <li class="victim">
              <h3>
                {v.name}
                <span class="victim-name-fa" lang="fa" dir="rtl">{v.name_fa}</span>
              </h3>
              <p class="victim-meta">
                {v.age ? (lang === 'fa' ? `${localizeDigits(String(v.age), lang)} ساله · ` : `Aged ${v.age} · `) : ''}
                {v.place} · <time datetime={v.date}>{formatDate(v.date, lang)}</time>
              </p>
              <p>{v.summary}</p>
              <a class="text-link" href={v.url} target="_blank" rel="noopener noreferrer">
                {t(lang, 'victimRecord')} — {v.source} <span class="arrow" aria-hidden="true">→</span>
                <span class="sr-only">{t(lang, 'opensNewTab')}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="docs-heading">
      <h2 id="docs-heading" class="list-heading">{t(lang, 'documentation')}</h2>
      <p class="muted">{t(lang, 'victimsOrgsIntro')}</p>
      <ul class="org-cards">
        {orgs.map((org) => (
          <li class="org-card">
            <h3>
              <a href={org.url} target="_blank" rel="noopener noreferrer">
                {org.title} <span class="arrow" aria-hidden="true">→</span>
                <span class="sr-only">{t(lang, 'opensNewTab')}</span>
              </a>
            </h3>
            {(org.description || org.description_fa) && (
              <p>{lang === 'fa' && org.description_fa ? org.description_fa : org.description}</p>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
