---
import '../styles/main.css';
import { currentAdminEmail, isAccessConfigured, isAuthenticated } from '../lib/auth';
import { BANNER_TYPES, CATEGORIES, ICONS } from '../lib/content-schema';

// Cloudflare Access authenticates the visitor before the request reaches the
// Worker; this re-verifies the assertion it forwards. A request that arrives
// without a valid one never sees the CMS markup, so a route that somehow
// bypasses Access still gets nothing.
const authed = await isAuthenticated(Astro.request);
const adminEmail = authed ? await currentAdminEmail(Astro.request) : '';
const configured = isAccessConfigured() || import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — Stand With Iran</title>
  </head>
  <body>
    <div class="admin-wrap">
      <div class="admin-container">
        <div class="admin-header">
          <h1>ADMIN PANEL</h1>
          {authed && (
            <div class="admin-identity">
              {adminEmail && <span class="admin-email">{adminEmail}</span>}
              <a href="/cdn-cgi/access/logout" class="btn btn-small btn-logout">Logout</a>
            </div>
          )}
        </div>

        <div id="toast" class="admin-toast" hidden></div>

        {!authed && (
          <section class="panel">
            <div class="panel-header"><span>Access required</span></div>
            <div class="panel-body">
              <p class="form-error">
                {configured
                  ? 'This page is protected by Cloudflare Access. Reload to sign in; if you keep landing here, your account is not covered by the Access policy for this application.'
                  : 'Cloudflare Access is not configured for this Worker. Set CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD before the admin panel will open.'}
              </p>
            </div>
          </section>
        )}

        {authed && (
          <div id="cms">
          <!-- Banner -->
          <section class="panel">
            <div class="panel-header"><span>Banner</span></div>
            <div class="panel-body">
              <form class="admin-form" data-config-form>
                <div class="form-row">
                  <label class="checkbox-label">
                    <input type="checkbox" name="banner_enabled" value="1" />
                    Enabled
                  </label>
                </div>
                <div class="form-group">
                  <label>Type</label>
                  <select name="banner_type">
                    {BANNER_TYPES.map((t) => <option value={t}>{t}</option>)}
                  </select>
                </div>
                <div class="form-group">
                  <label>Text</label>
                  <input name="banner_text" type="text" />
                </div>
                <div class="form-group">
                  <label>Link URL</label>
                  <input name="banner_link" type="text" />
                </div>
                <button type="submit" class="btn btn-primary">Save Banner</button>
              </form>
            </div>
          </section>

          <!-- Profile EN -->
          <section class="panel">
            <div class="panel-header"><span>Profile Description (English)</span></div>
            <div class="panel-body">
              <form class="admin-form" data-config-form>
                <div class="form-group">
                  <label>About Text (separate paragraphs with blank lines)</label>
                  <textarea name="profile_description" rows="10"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save Profile (EN)</button>
              </form>
            </div>
          </section>

          <!-- Profile FA -->
          <section class="panel">
            <div class="panel-header"><span>Profile Description (Farsi)</span></div>
            <div class="panel-body">
              <form class="admin-form" data-config-form>
                <div class="form-group">
                  <label>About Text (Farsi)</label>
                  <textarea name="profile_description_fa" rows="10" dir="rtl"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save Profile (FA)</button>
              </form>
            </div>
          </section>

          <!-- Site Config -->
          <section class="panel">
            <div class="panel-header"><span>Site Config</span></div>
            <div class="panel-body">
              <form class="admin-form" data-config-form>
                <div class="form-group">
                  <label>Contact Email</label>
                  <input name="contact_email" type="email" />
                </div>
                <div class="form-group">
                  <label for="cfg-last-updated">Last Updated (YYYY-MM-DD)</label>
                  <input id="cfg-last-updated" name="last_updated" type="date" />
                </div>
                <button type="submit" class="btn btn-primary">Save Config</button>
              </form>
            </div>
          </section>

          <!-- Stat counters -->
          <section class="panel">
            <div class="panel-header"><span>Stat Counters</span></div>
            <div class="panel-body">
              <form class="admin-form" data-config-form>
                <div class="form-group">
                  <label for="cfg-amini">Mahsa Jina Amini (YYYY-MM-DD)</label>
                  <input id="cfg-amini" name="stat_amini_date" type="date" required />
                </div>
                <div class="form-group">
                  <label for="cfg-protest">Latest protest (YYYY-MM-DD)</label>
                  <input id="cfg-protest" name="stat_protest_date" type="date" required />
                </div>
                <div class="form-group">
                  <label for="cfg-blackout">Internet blackout (YYYY-MM-DD)</label>
                  <input id="cfg-blackout" name="stat_blackout_date" type="date" required />
                </div>
                <button type="submit" class="btn btn-primary">Save Counters</button>
              </form>
            </div>
          </section>

          <!-- Links -->
          <section class="panel">
            <div class="panel-header"><span>Links (<span id="links-count">0</span>)</span></div>
            <div class="panel-body">
              <div id="links-list" class="admin-links-list"></div>

              <form id="add-link-form" class="admin-form add-link-form">
                <h3>Add Link</h3>
                <div class="form-group">
                  <label>Title</label>
                  <input name="title" type="text" required placeholder="Link title" />
                </div>
                <div class="form-group">
                  <label>URL</label>
                  <input name="url" type="text" required placeholder="https://..." />
                </div>
                <div class="form-row-2">
                  <div class="form-group">
                    <label>Icon</label>
                    <select name="icon">
                      {ICONS.map((ic) => <option value={ic}>{ic}</option>)}
                    </select>
                  </div>
                  <div class="form-group">
                    <label>Category</label>
                    <select name="category">
                      {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
                    </select>
                  </div>
                </div>
                <label class="checkbox-label">
                  <input name="featured" type="checkbox" />
                  Featured
                </label>
                <button type="submit" class="btn btn-primary">Add Link</button>
              </form>
            </div>
          </section>
          </div>
        )}
      </div>
    </div>

    <template id="link-row-tpl">
      <div class="admin-link-item">
        <div class="link-info">
          <span class="link-title-admin" data-field="title"></span>
          <span class="link-url-admin" data-field="url"></span>
          <span class="link-meta-admin" data-field="meta"></span>
        </div>
        <div class="link-actions">
          <button class="btn btn-small" data-action="up" title="Move up">↑</button>
          <button class="btn btn-small" data-action="down" title="Move down">↓</button>
          <button class="btn btn-small" data-action="edit">Edit</button>
          <button class="btn btn-small btn-danger" data-action="del">Del</button>
        </div>
      </div>
    </template>

    <template id="link-edit-tpl">
      <div class="admin-link-item">
        <form class="admin-form edit-form">
          <div class="form-group">
            <label>Title</label>
            <input name="title" type="text" />
          </div>
          <div class="form-group">
            <label>URL</label>
            <input name="url" type="text" />
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label>Icon</label>
              <select name="icon">
                {ICONS.map((ic) => <option value={ic}>{ic}</option>)}
              </select>
            </div>
            <div class="form-group">
              <label>Category</label>
              <select name="category">
                {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
          </div>
          <label class="checkbox-label">
            <input name="featured" type="checkbox" />
            Featured
          </label>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-small">Save</button>
            <button type="button" class="btn btn-small" data-action="cancel">Cancel</button>
          </div>
        </form>
      </div>
    </template>

    <script>
      import type { LinkRow } from '../lib/types';

      type ConfigMap = Record<string, string>;

      // worker-configuration.d.ts declares a global `interface Element` for
      // HTMLRewriter, which merges with the DOM `Element` and leaves `remove()`
      // ambiguous. Any generic constrained by `Element` (querySelector<T>)
      // therefore fails to compile, so these helpers cast instead.
      type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

      const $ = <T extends HTMLElement>(sel: string) =>
        document.querySelector(sel) as T | null;

      const byName = <T extends Field>(form: HTMLElement, name: string) =>
        form.querySelector(`[name="${name}"]`) as T;

      const fieldsOf = (form: HTMLElement) =>
        Array.from(form.querySelectorAll('[name]')) as Field[];

      const cms = $('#cms');
      const toast = $('#toast')!;
      const linksList = $('#links-list')!;
      const linksCount = $('#links-count')!;
      const addLinkForm = $<HTMLFormElement>('#add-link-form');

      let links: LinkRow[] = [];
      let config: ConfigMap = {};
      let editingId: number | null = null;
      let toastTimer: number | undefined;

      async function api<T>(path: string, opts: RequestInit = {}): Promise<T> {
        const headers = { 'Content-Type': 'application/json', ...(opts.headers ?? {}) };
        const res = await fetch(`/api${path}`, { ...opts, headers, credentials: 'same-origin' });
        if (res.status === 401) {
          // Access session expired — reload so Access can re-challenge.
          location.reload();
          throw new Error('Unauthorized');
        }
        if (!res.ok) {
          const body = await res.json().catch(() => ({}) as { error?: string });
          throw new Error((body as { error?: string }).error || `HTTP ${res.status}`);
        }
        return res.json() as Promise<T>;
      }

      function message(err: unknown): string {
        return err instanceof Error ? err.message : String(err);
      }

      function showToast(msg: string) {
        toast.textContent = msg;
        toast.hidden = false;
        // Without clearing, overlapping saves hid the newest message early.
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.hidden = true;
        }, 3000);
      }

      async function loadAll() {
        const [linksRes, configRes] = await Promise.all([
          api<{ links: LinkRow[] }>('/admin/links'),
          api<{ config: ConfigMap }>('/admin/config'),
        ]);
        links = linksRes.links ?? [];
        config = configRes.config ?? {};
        renderLinks();
        fillConfigForms();
      }

      function configForms(): HTMLFormElement[] {
        return Array.from(document.querySelectorAll('form[data-config-form]')) as HTMLFormElement[];
      }

      function fillConfigForms() {
        for (const form of configForms()) {
          for (const el of fieldsOf(form)) {
            const val = config[el.name] ?? '';
            if (el instanceof HTMLInputElement && el.type === 'checkbox') {
              el.checked = val === '1';
            } else {
              el.value = val;
            }
          }
        }
      }

      for (const form of configForms()) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const payload: ConfigMap = {};
          for (const el of fieldsOf(form)) {
            payload[el.name] =
              el instanceof HTMLInputElement && el.type === 'checkbox'
                ? el.checked
                  ? '1'
                  : '0'
                : el.value;
          }
          try {
            await api('/admin/config', { method: 'PUT', body: JSON.stringify(payload) });
            Object.assign(config, payload);
            showToast('Config saved');
          } catch (err) {
            showToast('Error: ' + message(err));
          }
        });
      }

      function template(id: string): HTMLElement {
        const tpl = $<HTMLTemplateElement>(id)!;
        const fragment = tpl.content.cloneNode(true) as DocumentFragment;
        return fragment.querySelector('.admin-link-item') as HTMLElement;
      }

      function renderLinks() {
        linksList.replaceChildren();
        linksCount.textContent = String(links.length);
        links.forEach((link, index) => {
          linksList.appendChild(
            editingId === link.id ? renderEditRow(link) : renderViewRow(link, index),
          );
        });
      }

      function renderViewRow(link: LinkRow, index: number): HTMLElement {
        const root = template('#link-row-tpl');
        (root.querySelector('[data-field="title"]') as HTMLElement).textContent = link.title;
        (root.querySelector('[data-field="url"]') as HTMLElement).textContent = link.url;
        (root.querySelector('[data-field="meta"]') as HTMLElement).textContent =
          `${link.icon} · ${link.category}` + (link.featured ? ' · featured' : '');

        const upBtn = root.querySelector('[data-action="up"]') as HTMLButtonElement;
        const downBtn = root.querySelector('[data-action="down"]') as HTMLButtonElement;
        upBtn.disabled = index === 0;
        downBtn.disabled = index >= links.length - 1;
        upBtn.addEventListener('click', () => moveLink(index, -1));
        downBtn.addEventListener('click', () => moveLink(index, 1));

        root.querySelector('[data-action="edit"]')!.addEventListener('click', () => {
          editingId = link.id;
          renderLinks();
        });
        root
          .querySelector('[data-action="del"]')!
          .addEventListener('click', () => deleteLink(link.id));
        return root;
      }

      function renderEditRow(link: LinkRow): HTMLElement {
        const root = template('#link-edit-tpl');
        const form = root.querySelector('form') as HTMLFormElement;

        // The option lists are rendered into the template server side, from the
        // same vocabulary the API validates against.
        const iconSel = byName<HTMLSelectElement>(form, 'icon');
        const catSel = byName<HTMLSelectElement>(form, 'category');
        iconSel.value = link.icon;
        catSel.value = link.category;
        byName<HTMLInputElement>(form, 'title').value = link.title;
        byName<HTMLInputElement>(form, 'url').value = link.url;
        byName<HTMLInputElement>(form, 'featured').checked = Boolean(link.featured);

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const payload = {
            title: byName<HTMLInputElement>(form, 'title').value,
            url: byName<HTMLInputElement>(form, 'url').value,
            icon: iconSel.value,
            category: catSel.value,
            featured: byName<HTMLInputElement>(form, 'featured').checked,
          };
          try {
            await api(`/admin/links/${link.id}`, {
              method: 'PUT',
              body: JSON.stringify(payload),
            });
            editingId = null;
            await reloadLinks();
            showToast('Link updated');
          } catch (err) {
            showToast('Error: ' + message(err));
          }
        });

        root.querySelector('[data-action="cancel"]')!.addEventListener('click', () => {
          editingId = null;
          renderLinks();
        });
        return root;
      }

      async function reloadLinks() {
        const res = await api<{ links: LinkRow[] }>('/admin/links');
        links = res.links ?? [];
        renderLinks();
      }

      async function deleteLink(id: number) {
        if (!confirm('Delete this link?')) return;
        try {
          await api(`/admin/links/${id}`, { method: 'DELETE' });
          if (editingId === id) editingId = null;
          await reloadLinks();
          showToast('Link deleted');
        } catch (err) {
          showToast('Error: ' + message(err));
        }
      }

      let reordering = false;
      async function moveLink(index: number, dir: number) {
        if (reordering) return;
        const target = index + dir;
        if (!links[index] || !links[target]) return;

        // One batched write for the whole list. Two independent PUTs could
        // half-apply and leave the ordering corrupted with no rollback.
        const ids = links.map((link) => link.id);
        [ids[index], ids[target]] = [ids[target], ids[index]];

        reordering = true;
        try {
          await api('/admin/links/reorder', { method: 'POST', body: JSON.stringify({ ids }) });
          await reloadLinks();
        } catch (err) {
          showToast('Error: ' + message(err));
        } finally {
          reordering = false;
        }
      }

      addLinkForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          title: byName<HTMLInputElement>(addLinkForm, 'title').value,
          url: byName<HTMLInputElement>(addLinkForm, 'url').value,
          icon: byName<HTMLSelectElement>(addLinkForm, 'icon').value,
          category: byName<HTMLSelectElement>(addLinkForm, 'category').value,
          featured: byName<HTMLInputElement>(addLinkForm, 'featured').checked,
        };
        if (!payload.title || !payload.url) return;
        try {
          await api('/admin/links', { method: 'POST', body: JSON.stringify(payload) });
          addLinkForm.reset();
          await reloadLinks();
          showToast('Link added');
        } catch (err) {
          showToast('Error: ' + message(err));
        }
      });

      // CMS markup is only present when the server authenticated the request
      if (cms) {
        loadAll().catch((err) => showToast('Error: ' + message(err)));
      }
    </script>

    <style>
      .admin-wrap {
        /* accent vars the admin UI relies on, mapped to the editorial palette */
        --accent-green: var(--flag-green);
        --accent-red: var(--accent);
        --accent-blue: #2b5fff;
        min-height: 100vh;
        background: var(--bg);
        padding: 2.5rem 1rem 3rem;
      }
      .admin-container { max-width: 620px; margin: 0 auto; }
      .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.75rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--hairline-strong);
      }
      .admin-header h1 {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .admin-toast {
        background: var(--accent-green);
        color: white;
        padding: 0.6rem 1rem;
        margin-bottom: 1.25rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: var(--card-radius);
      }
      .admin-form { display: flex; flex-direction: column; gap: 0.85rem; }
      .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
      .form-group label {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
      }
      .form-group input,
      .form-group select,
      .form-group textarea {
        padding: 0.6rem 0.8rem;
        border: 1.5px solid #d0d0d0;
        border-radius: 5px;
        background: white;
        color: var(--text-dark);
        font-family: var(--font-body);
        font-size: 0.8rem;
      }
      .form-group textarea { resize: vertical; min-height: 140px; line-height: 1.6; }
      .form-group input:focus,
      .form-group select:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: var(--accent-blue);
        box-shadow: 0 0 0 3px rgba(51, 85, 255, 0.1);
      }
      .form-row { display: flex; align-items: center; gap: 0.5rem; }
      .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; }
      .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.78rem;
        color: var(--text-dark);
        cursor: pointer;
      }
      .checkbox-label input { width: auto; }
      .form-error { color: var(--accent-red); font-size: 0.78rem; font-weight: 700; }
      .form-actions { display: flex; gap: 0.5rem; }
      .btn {
        padding: 0.55rem 1.15rem;
        border: 1.5px solid #d0d0d0;
        border-radius: 5px;
        background: white;
        color: var(--text-dark);
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        cursor: pointer;
      }
      .btn:hover { background: #f0f0f0; border-color: #bbb; }
      .btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .btn-primary {
        background: var(--accent-green);
        color: white;
        border-color: var(--accent-green);
      }
      .btn-primary:hover { background: #007a2e; border-color: #007a2e; }
      .btn-danger {
        background: transparent;
        color: var(--accent-red);
        border-color: var(--accent-red);
      }
      .btn-danger:hover { background: var(--accent-red); color: white; }
      .admin-identity {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .admin-email {
        font-size: 0.75rem;
        opacity: 0.7;
      }

      .btn-logout {
        background: transparent;
        color: var(--text-muted);
        border-color: var(--hairline-strong);
      }
      .btn-logout:hover { color: var(--accent); border-color: var(--accent); background: transparent; }
      .btn-small { padding: 0.35rem 0.6rem; font-size: 0.65rem; }
      .admin-links-list { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.5rem; }
      .admin-link-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.8rem 0.85rem;
        border: 1.5px solid #e8e8e8;
        border-radius: var(--card-radius);
        background: white;
      }
      .admin-link-item:hover { border-color: #ccc; }
      .link-info { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; flex: 1; }
      .link-title-admin {
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--text-dark);
      }
      .link-url-admin {
        font-size: 0.68rem;
        color: #999;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .link-meta-admin { font-size: 0.62rem; color: #bbb; text-transform: uppercase; margin-top: 0.1rem; }
      .link-actions { display: flex; gap: 0.25rem; flex-shrink: 0; align-items: center; }
      .edit-form { width: 100%; }
      .add-link-form { padding-top: 1.25rem; border-top: 1px solid #e8e8e8; }
      .add-link-form h3 {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-dark);
      }
    </style>
  </body>
</html>
