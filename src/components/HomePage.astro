---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsPanel from './StatsPanel.astro';
import Timeline from './Timeline.astro';
import { NAV_LABEL, otherLocale, pageHref, t, type Lang } from '../lib/i18n';
import { getSiteData } from '../lib/site-data';
import { seo } from '../lib/seo';

/** The home page for one locale; `index.astro` and `fa/index.astro` only pick the language. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = await getSiteData();
const other = otherLocale(lang);

// One word per line, as in the design. The panel repeats the slogan in the other language.
const headingWords = seo[lang].heading.split(' ');
const panelWords = seo[other].heading.replace(/[.،]/g, '').split(' ');

const cards = [
  { page: 'timeline', text: 'cardTimelineText' },
  { page: 'victims', text: 'cardVictimsText' },
  { page: 'evidence', text: 'cardEvidenceText' },
  { page: 'take-action', text: 'cardActionText' },
] as const;
---

<BaseLayout lang={lang} page="">
  <section class="hero wrap" aria-labelledby="hero-heading">
    <div class="hero-text">
      <p class="eyebrow">{t(lang, 'heroEyebrow')}</p>
      <h1 id="hero-heading">{headingWords.map((w) => <span>{w}</span>)}</h1>
      <p class="hero-lede">{t(lang, 'heroText')}</p>
      <div class="actions">
        <a class="btn btn-primary" href={pageHref(lang, 'timeline')}>{t(lang, 'heroLearn')}</a>
        <a class="btn btn-outline" href={pageHref(lang, 'victims')}>{t(lang, 'heroVictims')}</a>
      </div>
    </div>
    <div class="hero-panel" aria-hidden="true" lang={other} dir={other === 'fa' ? 'rtl' : 'ltr'}>
      {panelWords.map((w) => <span>{w}</span>)}
    </div>
  </section>

  <StatsPanel lang={lang} stats={site.stats} />

  <section class="section wrap" aria-labelledby="timeline-heading">
    <div class="section-head">
      <h2 id="timeline-heading">{t(lang, 'timelineTitle')}</h2>
      <a class="text-link" href={pageHref(lang, 'timeline')}>
        {t(lang, 'timelineMore')} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <Timeline events={site.timeline.filter((e) => e.featured)} lang={lang} />
  </section>

  <section class="section wrap" aria-labelledby="explore-heading">
    <h2 id="explore-heading" class="section-title">{t(lang, 'explore')}</h2>
    <ul class="cards">
      {cards.map((c) => (
        <li>
          <a class="card" href={pageHref(lang, c.page)}>
            <h3>{t(lang, NAV_LABEL[c.page])}</h3>
            <p>{t(lang, c.text)}</p>
            <span class="card-open">
              {t(lang, 'open')} <span class="arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap memorial-wrap" aria-labelledby="memorial-heading">
    <div class="memorial">
      <h2 id="memorial-heading">{t(lang, 'memorialTitle')}</h2>
      <a class="btn btn-light" href={pageHref(lang, 'victims')}>{t(lang, 'memorialCta')}</a>
    </div>
  </section>
</BaseLayout>
