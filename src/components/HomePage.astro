---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import StatsPanel from './StatsPanel.astro';
import Timeline from './Timeline.astro';
import { pageHref, t, type Lang } from '../lib/i18n';
import { getSiteData } from '../lib/site-data';
import { seo } from '../lib/seo';

/** The home page for one locale; `index.astro` and `fa/index.astro` only pick the language. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const site = await getSiteData();

const cards = [
  { page: 'timeline', icon: 'book', title: 'cardTimeline', text: 'cardTimelineText' },
  { page: 'victims', icon: 'people', title: 'cardVictims', text: 'cardVictimsText' },
  { page: 'evidence', icon: 'document', title: 'cardEvidence', text: 'cardEvidenceText' },
  { page: 'take-action', icon: 'megaphone', title: 'cardAction', text: 'cardActionText' },
] as const;
---

<BaseLayout lang={lang} page="">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-text">
      <p class="eyebrow eyebrow-rule">{t(lang, 'heroEyebrow')}</p>
      <h1 id="hero-heading">{seo[lang].heading}</h1>
      <p class="hero-lede">{t(lang, 'heroText')}</p>
      <div class="actions">
        <a class="btn btn-primary" href={pageHref(lang, 'timeline')}>
          {t(lang, 'heroLearn')} <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-outline" href={pageHref(lang, 'victims')}>{t(lang, 'heroVictims')}</a>
      </div>
    </div>
    <div class="hero-media">
      <img
        src="/images/hero-isfahan.webp"
        alt="Si-o-se-pol bridge illuminated at night over the Zayanderud, Isfahan, Iran"
        width="1200"
        height="676"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <StatsPanel lang={lang} stats={site.stats} />

  <section class="section wrap" aria-labelledby="timeline-heading">
    <div class="section-head">
      <div>
        <h2 id="timeline-heading">{t(lang, 'timelineTitle')}</h2>
        <p class="section-sub">{t(lang, 'timelineSub')}</p>
      </div>
      <a class="text-link" href={pageHref(lang, 'timeline')}>
        {t(lang, 'timelineMore')} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <Timeline events={site.timeline.filter((e) => e.featured)} lang={lang} />
  </section>

  <section class="section section-surface" aria-labelledby="explore-heading">
    <div class="wrap">
      <h2 id="explore-heading" class="sr-only">{t(lang, 'explore')}</h2>
      <ul class="cards">
        {cards.map((c) => (
          <li>
            <a class="card" href={pageHref(lang, c.page)}>
              <Icon name={c.icon} size={28} />
              <h3>{t(lang, c.title)}</h3>
              <p>{t(lang, c.text)}</p>
              <span class="arrow card-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="memorial" aria-labelledby="memorial-heading">
    <div class="wrap memorial-inner">
      <div>
        <h2 id="memorial-heading">{t(lang, 'memorialTitle')}</h2>
        <p>{t(lang, 'memorialText')}</p>
      </div>
      <a class="btn btn-outline" href={pageHref(lang, 'victims')}>
        {t(lang, 'memorialCta')} <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
