---
import { formatDate, pageHref, t, type Lang } from '../lib/i18n';
import type { Link } from '../lib/types';

interface Props {
  contactEmail: string;
  lastUpdated: string;
  lang: Lang;
  /** Related projects: the `documentation: true` links. */
  related: Link[];
}

const { contactEmail, lastUpdated, lang, related } = Astro.props;

// Only a real ISO date belongs in `datetime`.
const lastUpdatedIso = /^\d{4}-\d{2}-\d{2}$/.test(lastUpdated) ? lastUpdated : undefined;
---

<section class="wrap closing" aria-label={t(lang, 'related')}>
  <p class="closing-title">{t(lang, 'footerTitle')} {t(lang, 'footerSub')}</p>

  {related.length > 0 && (
    <div class="related">
      <h2 class="related-heading">{t(lang, 'related')}</h2>
      <ul class="related-list">
        {related.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer" lang="en">
              {link.title} <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</section>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-info">
      <p class="footer-wordmark" lang="en">Stand With Iran</p>
      {contactEmail && (
        <p><a href={`mailto:${contactEmail}`} dir="ltr" aria-label={`${t(lang, 'contact')}: ${contactEmail}`}>{contactEmail}</a></p>
      )}
      <p>
        {t(lang, 'lastUpdated')}:{' '}
        <time datetime={lastUpdatedIso}>{formatDate(lastUpdated, lang)}</time>
      </p>
    </div>
    <ul class="footer-legal">
      <li><a href={pageHref(lang, 'terms')}>{t(lang, 'terms')}</a></li>
      <li><a href={pageHref(lang, 'privacy')}>{t(lang, 'privacy')}</a></li>
    </ul>
  </div>
</footer>
