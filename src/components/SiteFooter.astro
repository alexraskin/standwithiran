---
import { formatDate, NAV_LABEL, pageHref, PAGES, t, type Lang } from '../lib/i18n';
import type { Link } from '../lib/types';

interface Props {
  contactEmail: string;
  lastUpdated: string;
  lang: Lang;
  /** Related projects: the `documentation: true` links. */
  related: Link[];
}

const { contactEmail, lastUpdated, lang, related } = Astro.props;

// Only a real ISO date belongs in `datetime`.
const lastUpdatedIso = /^\d{4}-\d{2}-\d{2}$/.test(lastUpdated) ? lastUpdated : undefined;
---

<footer class="site-footer">
  <div class="wrap footer-top">
    <div class="footer-message">
      <p class="footer-title">{t(lang, 'footerTitle')}</p>
      <p class="footer-sub">{t(lang, 'footerSub')}</p>
    </div>

    <nav aria-label={t(lang, 'explore')}>
      <ul class="footer-list">
        {PAGES.map((p) => (
          <li><a href={pageHref(lang, p)}>{t(lang, NAV_LABEL[p])}</a></li>
        ))}
      </ul>
    </nav>

    {related.length > 0 && (
      <div>
        <h2 class="footer-heading">{t(lang, 'related')}</h2>
        <ul class="footer-list">
          {related.map((link) => (
            <li><a href={link.url} target="_blank" rel="noopener noreferrer" lang="en">{link.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="wrap footer-bottom">
    <p>
      {t(lang, 'lastUpdated')}:{' '}
      <time datetime={lastUpdatedIso}>{formatDate(lastUpdated, lang)}</time>
    </p>
    <p>
      {t(lang, 'heroCredit')}
    </p>
    {contactEmail && (
      <p>{t(lang, 'contact')}: <a href={`mailto:${contactEmail}`} dir="ltr">{contactEmail}</a></p>
    )}
    <p><a href={pageHref(lang, 'terms')}>{t(lang, 'terms')}</a></p>
    <p><a href={pageHref(lang, 'privacy')}>{t(lang, 'privacy')}</a></p>
  </div>
</footer>
