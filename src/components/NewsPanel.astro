---
import { getNewsItems } from '../lib/news';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = (await getNewsItems()) ?? [];
const now = Date.now();

/**
 * `new Date(bad)` returns an Invalid Date rather than throwing, so the previous
 * try/catch never fired: every NaN comparison was false and the function fell
 * through to toLocaleDateString, printing the literal string "Invalid Date".
 */
function formatDate(dateStr: string): string {
  if (!dateStr) return '';

  const time = Date.parse(dateStr);
  if (Number.isNaN(time)) return '';

  const diffHours = Math.floor((now - time) / 3_600_000);
  const diffDays = Math.floor((now - time) / 86_400_000);

  if (diffHours < 1) return t(lang, 'newsJustNow');
  if (diffHours < 24) return `${diffHours}${t(lang, 'newsHoursAgo')}`;
  if (diffDays < 7) return `${diffDays}${t(lang, 'newsDaysAgo')}`;

  // Older items fall back to a date, which has to follow the page locale.
  return new Date(time).toLocaleDateString(lang === 'fa' ? 'fa-IR' : 'en-US', {
    month: 'short',
    day: 'numeric',
  });
}

const cards = items.map((item) => ({ ...item, date: formatDate(item.pubDate) }));
---

<section class="panel">
  <div class="panel-header header-news">
    <span>{t(lang, 'newsTitle')}</span>
    <a href="https://azadiwire.org" target="_blank" rel="noopener noreferrer" class="news-source-link">
      AZADIWIRE.ORG
    </a>
  </div>
  <div class="panel-body news-body">
    {cards.length === 0 && <p class="news-loading">{t(lang, 'newsError')}</p>}
    {cards.map((item) => (
      <a href={item.link} class="news-card" target="_blank" rel="noopener noreferrer">
        <div class="news-content">
          <span class="news-headline">{item.title}</span>
          {item.description && <span class="news-desc">{item.description}</span>}
          <div class="news-meta">
            {item.date && <span class="news-date">{item.date}</span>}
            {item.category && <span class="news-category">{item.category}</span>}
          </div>
        </div>
        <span class="news-arrow" aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </div>
</section>
