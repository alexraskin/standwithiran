---
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="panel" aria-labelledby="share-heading">
  <div class="panel-header header-dark">
    <h2 id="share-heading" class="panel-heading">{t(lang, 'shareTitle')}</h2>
  </div>
  <div class="panel-body share-body">
    <div class="share-grid">
      <button class="share-btn share-x" title="Share on X" data-share="twitter">
