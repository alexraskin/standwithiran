---
import { t, type Lang } from '../lib/i18n';
import { DEFAULT_STAT_DATES } from '../lib/site-data';
import type { StatDates } from '../lib/types';

interface Props {
  lang: Lang;
  /** ISO dates from D1 config. These used to be literals in this file, which
   *  made the page's most time-sensitive numbers the only content an admin
   *  could not edit. */
  stats: StatDates;
}

const { lang, stats } = Astro.props;

const now = Date.now();

const parseIso = (value: string) => Date.parse(`${value}T00:00:00Z`);

/** Never reports a negative count for a date in the future. */
const daysBetween = (startMs: number) => Math.max(0, Math.floor((now - startMs) / 86_400_000));

/** Falls back to the seeded date when a config row is missing or unparseable. */
function daysSince(value: string, fallback: string): number {
  const parsed = parseIso(value);
  return daysBetween(Number.isNaN(parsed) ? parseIso(fallback) : parsed);
}

/** For counters with no seeded fallback. Returns null so the caller can drop
 *  the block rather than render a count from a date nobody set. */
function daysSinceOptional(value: string): number | null {
  const parsed = parseIso(value);
  return Number.isNaN(parsed) ? null : daysBetween(parsed);
}

const numLocale = lang === 'fa' ? 'fa-IR' : 'en-US';
const fmt = (n: number) => n.toLocaleString(numLocale);

// The war counter is optional. While `stat_war_date` is unset the strip is
// exactly the three counters it has always been; once set, the war count takes
// the primary slot and Amini drops to secondary.
const warDays = daysSinceOptional(stats.war);

const blocks = [
  ...(warDays === null
    ? []
    : [{ value: warDays, label: t(lang, 'statWar'), primary: true }]),
  {
    value: daysSince(stats.amini, DEFAULT_STAT_DATES.amini),
    label: t(lang, 'statDays'),
    primary: warDays === null,
  },
  { value: daysSince(stats.protest, DEFAULT_STAT_DATES.protest), label: t(lang, 'statProtest'), primary: false },
  { value: daysSince(stats.blackout, DEFAULT_STAT_DATES.blackout), label: t(lang, 'statBlackout'), primary: false },
];
---

<section class:list={['stats-strip', { 'stats-strip-wrap': blocks.length > 3 }]}>
  {blocks.map((block, i) => (
    <>
      {i > 0 && <div class="stat-divider" />}
      <div class:list={['stat-block', { 'stat-primary': block.primary }]}>
        <span class="stat-number">{fmt(block.value)}</span>
        <span class="stat-label">{block.label}</span>
      </div>
    </>
  ))}
</section>
