---
import { formatDate, t, type Lang } from '../lib/i18n';
import { DEFAULT_STAT_DATES } from '../lib/site-data';
import type { StatDates } from '../lib/types';

interface Props {
  lang: Lang;
  /** ISO dates from src/data/site.yaml. */
  stats: StatDates;
}

const { lang, stats } = Astro.props;

const parseIso = (value: string) => Date.parse(`${value}T00:00:00Z`);

/** Falls back to the seeded date when the value is empty or unparsable. */
function startMs(value: string, fallback: string): number {
  const parsed = parseIso(value);
  return Number.isNaN(parsed) ? parseIso(fallback) : parsed;
}

/** Never reports a negative count for a date in the future. Duplicated in the
 *  script below, which recomputes the count in the browser. */
const daysSince = (ms: number) => Math.max(0, Math.floor((Date.now() - ms) / 86_400_000));

const numLocale = lang === 'fa' ? 'fa-IR' : 'en-US';

// The war counter is optional and has no fallback date. While it is unset the
// strip is three counters; once set, the war count leads.
const warMs = parseIso(stats.war);
const hasWar = !Number.isNaN(warMs);

const blocks = [
  ...(hasWar ? [{ since: warMs, label: t(lang, 'statWar') }] : []),
  { since: startMs(stats.amini, DEFAULT_STAT_DATES.amini), label: t(lang, 'statDays') },
  { since: startMs(stats.protest, DEFAULT_STAT_DATES.protest), label: t(lang, 'statProtest') },
  { since: startMs(stats.blackout, DEFAULT_STAT_DATES.blackout), label: t(lang, 'statBlackout') },
].map((b) => ({ ...b, iso: new Date(b.since).toISOString().slice(0, 10) }));
---

<section class="stats" aria-labelledby="stats-heading">
  <h2 id="stats-heading" class="sr-only">{t(lang, 'statsHeading')}</h2>
  <dl class="wrap stats-strip" data-locale={numLocale}>
    {blocks.map((block) => (
      <div class="stat">
        <dt class="stat-label">{block.label}</dt>
        {/* Build-time count is the no-JS fallback; the script makes it current. */}
        <dd class="stat-number" data-since={block.since}>
          {daysSince(block.since).toLocaleString(numLocale)}
        </dd>
        <dd class="stat-context">
          {t(lang, 'since')} <time datetime={block.iso}>{formatDate(block.iso, lang)}</time>
        </dd>
      </div>
    ))}
  </dl>
</section>

<script>
  // The page is static, so the build-time counts go stale; recompute on load.
  const strip = document.querySelector<HTMLElement>('.stats-strip');
  const locale = strip?.dataset.locale;
  for (const el of document.querySelectorAll<HTMLElement>('[data-since]')) {
    const days = Math.max(0, Math.floor((Date.now() - Number(el.dataset.since)) / 86_400_000));
    el.textContent = days.toLocaleString(locale);
  }
</script>
