---
import { type Lang } from '../lib/i18n';
import { seo } from '../lib/seo';

interface Props {
  description: string;
  lang: Lang;
}

const { description, lang } = Astro.props;
const paragraphs = description.split('\n\n');
const heading = seo[lang].heading;
---

<section class="panel" aria-labelledby="site-heading">
  <div class="panel-header header-blue">
    <h1 id="site-heading" class="panel-heading">{heading}</h1>
  </div>
  <figure class="hero-image">
    <img
      src="/images/hero-isfahan.webp"
      alt="Si-o-se-pol bridge illuminated at night over the Zayanderud, Isfahan, Iran"
      width="1200"
      height="676"
      fetchpriority="high"
    />
    <figcaption class="hero-credit">
      Photo by
      <a href="https://unsplash.com/@mahdi3953?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener">Mahdi Karimi</a>
      on
      <a href="https://unsplash.com/photos/illuminated-bridge-reflects-in-still-water-at-night-XA3X-mKRu5Q?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener">Unsplash</a>
    </figcaption>
  </figure>
  <div class="panel-body profile-body">
    <div class="profile-desc">
      {paragraphs.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>
