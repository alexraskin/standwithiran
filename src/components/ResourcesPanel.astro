---
import { t, type Lang } from '../lib/i18n';
import { iconEmoji } from '../lib/content-schema';
import type { Link } from '../lib/types';

interface Props {
  links: Link[];
  lang: Lang;
}

const { links, lang } = Astro.props;

const actionLinks = links.filter((l) => l.featured);
const regularLinks = links.filter((l) => !l.featured);
---

{actionLinks.length > 0 && (
  <section class="action-section" aria-labelledby="take-action-heading">
    <div class="action-header">
      <h2 id="take-action-heading">{t(lang, 'takeAction')}</h2>
    </div>
    <div class="action-body">
      {actionLinks.map((link, i) => (
        <a
          href={link.url}
          class:list={['action-card', { 'action-card-urgent': i === 0 }]}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="action-icon" aria-hidden="true">{iconEmoji(link.icon)}</span>
          <div class="action-content">
            <span class="action-text">{link.title}</span>
            <span class={`action-badge cat-${link.category}`}>{link.category}</span>
          </div>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>
)}

<section class="panel" aria-labelledby="resources-heading">
  <div class="panel-header">
    <h2 id="resources-heading" class="panel-heading">{t(lang, 'resources')}</h2>
  </div>
  <nav class="panel-body links-body" aria-labelledby="resources-heading">
    {regularLinks.map((link) => (
      <a href={link.url} class="link-card" target="_blank" rel="noopener noreferrer">
        <span class="link-icon" aria-hidden="true">{iconEmoji(link.icon)}</span>
        <span class="link-text">{link.title}</span>
        <span class={`cat-badge cat-${link.category}`}>{link.category}</span>
        <span class="link-arrow" aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </nav>
</section>

<style>
  .action-header h2 {
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
</style>
