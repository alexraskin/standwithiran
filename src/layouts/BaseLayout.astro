---
import { Font } from 'astro:assets';
import '../styles/main.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteBanner from '../components/SiteBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getDir, t, type Lang, type Page } from '../lib/i18n';
import { canonicalFor, isoDate, OG_IMAGE, pageSeo, seo, SITE_NAME, SITE_URL } from '../lib/seo';
import { getSiteData } from '../lib/site-data';

interface Props {
  lang: Lang;
  /** Section being rendered. Omitted only by 404.astro, which is noindex with no canonical. */
  page?: Page;
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes appended to the page graph. */
  jsonLd?: Record<string, unknown>[];
}

const { lang, page, jsonLd = [] } = Astro.props;

const site = await getSiteData();
const copy = seo[lang];
const section = page ? pageSeo[lang][page] : undefined;
const pageTitle = Astro.props.title ?? (section ? `${section.title} — ${SITE_NAME}` : copy.title);
const pageDescription = Astro.props.description ?? section?.description ?? copy.description;
const ogTitle = section ? pageTitle : copy.ogTitle;
const ogDescription = section ? pageDescription : copy.ogDescription;
const dir = getDir(lang);
const indexable = page !== undefined;
const canonical = canonicalFor(lang, page ?? '');
const dateModified = isoDate(site.lastUpdated);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: SITE_NAME,
    alternateName: ['StandWithIran', 'زن، زندگی، آزادی', 'Woman, Life, Freedom'],
    url: `${SITE_URL}/`,
    description: copy.ogDescription,
    inLanguage: ['en', 'fa'],
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/icon-512.png`,
      width: 512,
      height: 512,
    },
    description: copy.ogDescription,
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: ogTitle,
    description: pageDescription,
    inLanguage: lang === 'fa' ? 'fa-IR' : 'en-US',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#organization` },
    primaryImageOfPage: { '@type': 'ImageObject', url: OG_IMAGE.url },
    ...(dateModified ? { dateModified } : {}),
  },
  ...jsonLd,
];

const jsonLdBody = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

/*
 * `type="application/ld+json"` is a data block, not an executable script, so
 * the CSP's script-src does not apply to it. Verified in Chromium against the
 * production build: no securitypolicyviolation is raised and the graph parses.
 */
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={indexable
        ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
        : 'noindex'}
    />
    <meta name="theme-color" content="#f6efe4" />

    {indexable && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={canonicalFor('en', page)} />
        <link rel="alternate" hreflang="fa" href={canonicalFor('fa', page)} />
        <link rel="alternate" hreflang="x-default" href={canonicalFor('en', page)} />
      </>
    )}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fa' ? 'en_US' : 'fa_IR'} />
    <meta property="og:image" content={OG_IMAGE.url} />
    <meta property="og:image:secure_url" content={OG_IMAGE.url} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={OG_IMAGE.url} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    <script type="application/ld+json" is:inline set:html={jsonLdBody} />

    <Font cssVariable="--font-newsreader" preload={lang === 'en'} />
    <Font cssVariable="--font-inter" preload={lang === 'en'} />
    <Font cssVariable="--font-vazirmatn" preload={lang === 'fa'} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <SiteHeader lang={lang} page={page} />
    <SiteBanner banner={site.banner} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter
      lang={lang}
      contactEmail={site.contactEmail}
      lastUpdated={site.lastUpdated}
      related={site.links.filter((l) => l.documentation)}
    />
  </body>
</html>
