---
import { Font } from 'astro:assets';
import '../styles/main.css';
import { getDir, otherLocale, type Lang } from '../lib/i18n';
import { canonicalFor, isoDate, OG_IMAGE, seo, SITE_NAME, SITE_URL } from '../lib/seo';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** `last_updated` from D1 config; surfaced as schema.org dateModified. */
  lastUpdated?: string;
  /** Extra JSON-LD nodes appended to the page graph. */
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, lastUpdated = '', jsonLd = [] } = Astro.props;

const copy = seo[lang];
const pageTitle = title ?? copy.title;
const pageDescription = description ?? copy.description;
const dir = getDir(lang);
const canonical = canonicalFor(lang);
const alternate = canonicalFor(otherLocale(lang));
const dateModified = isoDate(lastUpdated);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: SITE_NAME,
    alternateName: ['StandWithIran', 'زن، زندگی، آزادی', 'Woman, Life, Freedom'],
    url: `${SITE_URL}/`,
    description: copy.ogDescription,
    inLanguage: ['en', 'fa'],
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/images/standwithiran.png`,
      width: 192,
      height: 192,
    },
    description: copy.ogDescription,
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: copy.ogTitle,
    description: pageDescription,
    inLanguage: lang === 'fa' ? 'fa-IR' : 'en-US',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#organization` },
    primaryImageOfPage: { '@type': 'ImageObject', url: OG_IMAGE.url },
    ...(dateModified ? { dateModified } : {}),
  },
  ...jsonLd,
];
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#f4f2ec" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonicalFor('en')} />
    <link rel="alternate" hreflang="fa" href={canonicalFor('fa')} />
    <link rel="alternate" hreflang="x-default" href={canonicalFor('en')} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={copy.ogTitle} />
    <meta property="og:description" content={copy.ogDescription} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fa' ? 'en_US' : 'fa_IR'} />
    <meta property="og:image" content={OG_IMAGE.url} />
    <meta property="og:image:secure_url" content={OG_IMAGE.url} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={copy.ogTitle} />
    <meta name="twitter:description" content={copy.ogDescription} />
    <meta name="twitter:image" content={OG_IMAGE.url} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />

    <Font cssVariable="--font-newsreader" preload />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/images/standwithiran.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/images/standwithiran.png" />
  </head>
  <body>
    <slot />
    <noscript>
      <div style="max-width:580px;margin:2rem auto;padding:0 1rem;font-family:sans-serif;color:#1c1a16">
        <h2>{copy.ogTitle}</h2>
        <p>{pageDescription}</p>
        <p><a href={alternate}>{lang === 'en' ? 'فارسی' : 'English'}</a></p>
      </div>
    </noscript>
  </body>
</html>
