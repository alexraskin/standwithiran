{
	"name": "standwithiran",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "npm run build && wrangler pages dev",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "oxfmt src/",
		"deploy": "npm run build && wrangler pages deploy",
		"cf-typegen": "wrangler types",
		"db:create": "wrangler d1 create standwithiran-db",
		"db:migrate": "wrangler d1 migrations apply standwithiran-db --remote",
		"db:migrate:local": "wrangler d1 migrations apply standwithiran-db --local"
	},
	"dependencies": {
		"vue": "^3.5.27",
		"vue-router": "^5.0.2"
	},
	"devDependencies": {
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^24.10.11",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vue/tsconfig": "^0.8.1",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.27.0",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-vue-devtools": "^8.0.5",
		"vue-tsc": "^3.2.4",
		"wrangler": "^4.63.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
