{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "standwithiran",
	"compatibility_date": "2026-02-05",
	"pages_build_output_dir": "./dist",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "standwithiran-db",
			"database_id": "ae84c592-a582-4700-ab87-a92346bca011",
			"migrations_dir": "migrations"
		}
	]
}
