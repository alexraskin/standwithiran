{
	"compatibility_date": "2026-04-21",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		"nodejs_compat"
	],
	"name": "standwithiranv2",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "standwithiran-db",
			"database_id": "ae84c592-a582-4700-ab87-a92346bca011",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{
			"pattern": "standwithiran.org",
			"custom_domain": true
		},
		{
			"pattern": "www.standwithiran.org",
			"custom_domain": true
		}
	]
}